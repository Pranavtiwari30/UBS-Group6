# Payment Exception Orchestrator — LLM configuration
# Copy this file to `.env` and fill in OPENAI_API_KEY. The orchestrator loads `.env`
# automatically (real environment variables always take precedence).

# Required to enable the LLM stages. If unset, the orchestrator runs deterministic-only.
OPENAI_API_KEY=

# Final decision authority: the orchestrator's last word, behind a hard safety floor.
OPENAI_MODEL=gpt-5.4

# Specialist subagents (beneficiary / duplicate / compliance / network) reasoning model.
# A smaller/cheaper model is appropriate for the scoped specialist analyses.
OPENAI_SUBAGENT_MODEL=gpt-5.4-mini

# Optional: custom OpenAI-compatible endpoint (Azure / proxy / gateway). Leave blank for default.
OPENAI_BASE_URL=

# Optional: sampling temperature. Leave blank to use the model default
# (some newer models reject a custom temperature).
OPENAI_TEMPERATURE=

# Optional: max tool-call iterations in the agentic review loop.
OPENAI_MAX_TOOL_ITERATIONS=8

# Optional: set to 1/true/yes to force the deterministic-only path even when a key is present.
PAYMENT_EXCEPTION_DISABLE_LLM=
